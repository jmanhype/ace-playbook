# =============================================================================
# VAOS Voice Bridge Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All variables with defaults are optional. Required variables are marked.

# -- Supabase (REQUIRED) -----------------------------------------------------
# Used by the VAOS control plane integration. If you're running standalone
# without Supabase, you still need these set (the Zod schema requires them).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -- LLM API (REQUIRED) ------------------------------------------------------
# API key for the Reasoner's LLM backend (Anthropic, Z.AI proxy, etc.)
ANTHROPIC_AUTH_TOKEN=your-api-key-here

# Base URL for the Anthropic-compatible API.
# Default points to Z.AI proxy; change to https://api.anthropic.com for direct.
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic

# -- Voice Bridge Server -----------------------------------------------------
# Port for the bridge server (browser connects here).
# PORT=9001

# Logging level: debug, info, warn, error
# LOG_LEVEL=info

# -- PersonaPlex / Moshi 7B (System 1) ---------------------------------------
# IP or hostname of the server running PersonaPlex (moshi-server).
# PERSONAPLEX_HOST=10.0.0.3

# Port that moshi-server listens on.
# PERSONAPLEX_PORT=8998

# WebSocket path. Moshi default is /ws, some setups use /api/chat.
# PERSONAPLEX_WS_PATH=/ws

# Voice timbre file path ON THE PERSONAPLEX SERVER (not local).
# This is passed as a query parameter when connecting.
# VOICE_PROMPT_PATH=/opt/moshi/voices/NATF0.pt

# Audio sample rate in Hz. Must match PersonaPlex config.
# TTS_SAMPLE_RATE=24000

# -- Letta Agent (System 2) --------------------------------------------------
# Letta server URL. Typically runs on the same GPU box or a nearby host.
# LETTA_BASE_URL=http://10.0.0.3:8283

# Name of the Letta agent to use. The bridge resolves the ID from the name
# on startup. If the agent doesn't exist, it will be created on first use.
# LETTA_AGENT_NAME=voice-reasoner

# Timeout for System 2 responses (ms). If Letta+LLM takes longer, the
# request is abandoned and System 1 resumes.
# REASONER_TIMEOUT_MS=30000

# Timeout for belief state updates (ms). These are non-blocking background
# updates, so a shorter timeout is acceptable.
# BELIEF_UPDATE_TIMEOUT_MS=15000

# -- Ollama (optional fast LLM path) -----------------------------------------
# If configured, the Reasoner can use Ollama for faster responses on simpler
# queries instead of routing everything through the main LLM.
# OLLAMA_URL=http://192.168.1.143:11434
# OLLAMA_MODEL=qwen2.5:7b

# -- TLS / Self-Signed Certs -------------------------------------------------
# Chrome requires a secure context (HTTPS) for SpeechRecognition.
# The bridge auto-detects certs/key.pem and certs/cert.pem at startup.
# If connecting to PersonaPlex or Letta over self-signed TLS:
# NODE_TLS_REJECT_UNAUTHORIZED=0

# -- Voxtral (optional parallel audio listener) -------------------------------
# Two-step Mistral pipeline that replaces Chrome SpeechRecognition +
# text-based pattern matching + intent extraction with Voxtral models:
#   1. Voxtral Mini (3B) transcribes audio ($0.001/min)
#   2. Voxtral Small (24B) classifies with tool definitions ($0.09/M tokens)
# Get your API key at https://console.mistral.ai/
# VOXTRAL_ENABLED=false
# VOXTRAL_API_KEY=your-mistral-api-key
# VOXTRAL_BASE_URL=https://api.mistral.ai/v1
# VOXTRAL_MODEL=voxtral-mini-2507
# VOXTRAL_CLASSIFIER_MODEL=voxtral-small-2507
# VOXTRAL_BUFFER_SECONDS=4
# VOXTRAL_MODE=chat
# VOXTRAL_BUFFER_SECONDS=4
# VOXTRAL_MODE=chat
