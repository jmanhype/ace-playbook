# RCST v2 Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# Application
# =============================================================================
ENVIRONMENT=development  # development | testing | staging | production
API_VERSION=v1
DEBUG=true

# =============================================================================
# Security (CHANGE THESE IN PRODUCTION!)
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-minimum-32-characters-CHANGE-IN-PRODUCTION!
JWT_SECRET_KEY=your-jwt-secret-key-minimum-32-characters-CHANGE-IN-PRODUCTION!
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=7
SESSION_TIMEOUT_MINUTES=30

# =============================================================================
# Database (PostgreSQL with pgvector)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://rcst_user:rcst_password@localhost:5432/rcst_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# =============================================================================
# Redis (Caching & Celery Broker)
# =============================================================================
REDIS_URL=redis://:rcst_redis_password@localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# OIDC Authentication (Configure with your identity provider)
# =============================================================================
OIDC_DISCOVERY_URL=https://your-oidc-provider.com/.well-known/openid-configuration
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

# =============================================================================
# LLM Providers (Optional - for AI features)
# =============================================================================
# Primary provider (OpenAI)
OPENAI_API_KEY=sk-your-openai-key-here

# Secondary provider (Anthropic) - fallback
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Local provider (Ollama) - fallback
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# Storage (S3 for production, local for development)
# =============================================================================
STORAGE_BACKEND=local  # local | s3 | azure
STORAGE_LOCAL_PATH=./storage

# AWS S3 Configuration (if using s3 backend)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=rcst-v2-storage
AWS_S3_REGION=us-east-1

# Azure Blob Storage Configuration (if using azure backend)
AZURE_STORAGE_CONNECTION_STRING=your-azure-connection-string
AZURE_STORAGE_CONTAINER=rcst-v2-storage

# =============================================================================
# Observability (Prometheus, OpenTelemetry, Logging)
# =============================================================================
LOG_LEVEL=DEBUG  # DEBUG | INFO | WARNING | ERROR | CRITICAL
ENABLE_TRACING=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_MULTIPROC_DIR=  # Leave empty unless using multiprocess mode

# =============================================================================
# Rate Limiting (requests per minute)
# =============================================================================
RATE_LIMIT_UNAUTHENTICATED=10
RATE_LIMIT_AUTHENTICATED=100
RATE_LIMIT_ADMIN=1000

# =============================================================================
# File Upload
# =============================================================================
MAX_UPLOAD_SIZE_MB=50

# =============================================================================
# Compliance & Audit
# =============================================================================
AUDIT_LOG_RETENTION_YEARS=7
ALCOA_TIMESTAMP_FORMAT=ISO8601_UTC

# =============================================================================
# Embedding Model (sentence-transformers)
# =============================================================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# =============================================================================
# Celery (Background Tasks)
# =============================================================================
CELERY_BROKER_URL=  # Defaults to REDIS_URL if empty
CELERY_RESULT_BACKEND=  # Defaults to REDIS_URL if empty
